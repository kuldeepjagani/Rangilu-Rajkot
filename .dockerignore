# =============================================================================
# Docker Ignore Rules - Keep Images Lean and Secure
# =============================================================================

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Build output
dist
build
*.tsbuildinfo

# Environment files (security)
.env
.env.local
.env.*.local
.env.docker

# Development tools
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Git
.git
.gitignore
.gitattributes

# Documentation
*.md
docs
README.md
CHANGELOG.md
LICENSE

# Testing
coverage
.nyc_output
*.test.ts
*.test.js
*.spec.ts
*.spec.js
__tests__
__mocks__
jest.config.js
vitest.config.ts

# CI/CD
.github
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml

# Docker files (avoid recursive copies)
Dockerfile*
docker-compose*
.dockerignore

# Temporary files
tmp
temp
*.tmp
*.temp
*.log
logs

# Database (if using local SQLite for testing)
*.sqlite
*.sqlite3
*.db

# Prisma (generated files - will be regenerated)
prisma/*.db
prisma/*.db-journal
prisma/migrations/migration_lock.toml

# Uploads (mount as volume instead)
uploads/*
!uploads/.gitkeep

# Misc
.cache
.eslintcache
.prettiercache
